container_commands:
  01_db_permissions:
    command: |
      DB_PATH="/var/app/staging/db.sqlite3"
      touch $DB_PATH
      chmod 777 $DB_PATH
      chmod 777 $(dirname $DB_PATH)
    ignoreErrors: true
  02_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
    ignoreErrors: true
  03_fix_db_permissions_post_migrate:
    command: |
      chmod 777 /var/app/staging/db.sqlite3
    ignoreErrors: true
  04_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true
    ignoreErrors: true