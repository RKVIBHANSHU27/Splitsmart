container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
  02_admin:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py shell -c \"from django.contrib.auth import get_user_model; User = get_user_model(); User.objects.filter(username='admin').exists() or User.objects.create_superuser('vibhanshu@27', 'vibhanshurbk27@gmail.com', 'V1bh4n@2701')\""