container_commands:
  01_fix_db_permissions:
    command: |
      DB_PATH="/var/app/current/db.sqlite3"
      touch $DB_PATH
      chmod 664 $DB_PATH
      chown webapp:webapp $DB_PATH
      chmod 775 $(dirname $DB_PATH)
      chown webapp:webapp $(dirname $DB_PATH)
  02_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  03_fix_db_permissions_post_migrate:
    command: |
      DB_PATH="/var/app/current/db.sqlite3"
      chmod 664 $DB_PATH
      chown webapp:webapp $DB_PATH
  04_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: splitsmart.settings
  aws:elasticbeanstalk:container:python:
    WSGIPath: splitsmart.wsgi:application